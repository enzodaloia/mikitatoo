{% extends 'base.html.twig' %}

{% block title %}Blog index{% endblock %}

{% block body %}

<!-- Header -->

<section class="banner-header section-padding valign bg-img bg-fixed"
         data-overlay-dark="2"
         data-background="img/slider/1.jpg">
    <div class="container">
        <div class="row">
            <div class="col-md-8 text-left caption mt-90">
                <h5>
                    <a href="{{ path('app_index') }}">Accueil</a> / Blog
                </h5>
                <h2>Gestion du blog</h2>
                <hr>
                <p>Retrouvez et gérez les articles du blog.</p>
            </div>
        </div>
    </div>
</section>

<div class="line-vr-section"></div>

<!-- Blog table -->

<section class="section-padding bg-blck" style="padding-top: 50px; padding-bottom: 50px;">
    <div class="container">

    <div class="d-flex justify-content-between align-items-center mb-25">
        <div>
            <h4 class="mb-5">Articles</h4>
            <p class="mb-0">Liste des articles du blog.</p>
        </div>

        <a href="{{ path('app_blog_new') }}" class="btn-curve btn-1">
            <span>Créer un article</span>
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 60px;">ID</th>
                    <th style="width: 200px;">Titre</th>
                    <th>Contenu</th>
                    <th style="width: 160px;">Date</th>
                    <th style="width: 180px;" class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
            {% for blog in blogs %}
                <tr>
                    <td>{{ blog.id }}</td>

                    <td>
                        <strong>{{ blog.title }}</strong>
                    </td>

                    <td>
                        <div style="
                            max-width: 500px;
                            overflow: hidden;
                            text-overflow: ellipsis;
                            white-space: nowrap;
                        ">
                            {{ blog.content }}
                        </div>
                    </td>

                    <td>
                        {{ blog.createdAt ? blog.createdAt|date('d/m/Y H:i') : '-' }}
                    </td>

                    <td class="text-end">
                        <a href="{{ path('app_blog_show', {'id': blog.id}) }}"
                           class="btn-curve btn-1 mr-5">
                            <span>Voir</span>
                        </a>

                        <a href="{{ path('app_blog_edit', {'id': blog.id}) }}"
                           class="btn-curve btn-1">
                            <span>Modifier</span>
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center" style="padding: 25px;">
                        Aucun article trouvé.
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

</div>

</section>

{% endblock %}
