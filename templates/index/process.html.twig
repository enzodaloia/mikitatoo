{% extends 'base.html.twig' %}

{% block title %}Soins & cicatrisation | Ginko Body Art{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/soins.css') }}">
{% endblock %}

{% set soins = [
    {
        id: 'tatouage',
        label: 'Tatouage',
        icon: 'fa-solid fa-pen-nib',
        image: 'img/site/soins-tatouage.jpg',
        intro: 'Quelques gestes simples pour une cicatrisation au top et des couleurs qui durent.',
        routine: [
            { icon: 'fa-solid fa-bandage', title: 'Le pansement', text: 'Gardez la seconde peau ou le film jusqu’au moment indiqué par votre tatoueur.' },
            { icon: 'fa-solid fa-pump-soap', title: 'Nettoyage', text: 'Mains propres, savon doux au pH neutre, eau tiède. On mousse doucement, sans frotter.' },
            { icon: 'fa-solid fa-hand-holding-droplet', title: 'Séchage', text: 'Tamponnez avec une serviette ou une compresse propre.' },
            { icon: 'fa-solid fa-jar', title: 'Hydratation', text: 'Une très fine couche de crème adaptée, quand votre tatoueur le recommande.' },
        ],
        eviter: ['Gratter ou arracher les croûtes', 'Bain, piscine, mer, jacuzzi', 'Le soleil', 'Trop de crème'],
        normal: ['Légère rougeur ou sensibilité', 'Petites croûtes et peau qui pèle'],
        consulter: ['Douleur forte ou qui augmente', 'Rougeur qui s’étend, gros gonflement', 'Écoulement inhabituel ou fièvre'],
        bonus: 'Une fois cicatrisé : hydratez régulièrement et protégez votre tatouage du soleil pour garder des couleurs éclatantes.',
    },
    {
        id: 'piercing',
        label: 'Piercing',
        icon: 'fa-solid fa-ring',
        image: 'img/site/soins-piercing.jpg',
        intro: 'Un piercing bien soigné, c’est une cicatrisation sereine et sans complication.',
        routine: [
            { icon: 'fa-solid fa-hands-bubbles', title: 'Mains propres', text: 'Lavez-vous les mains avant de toucher votre piercing.' },
            { icon: 'fa-solid fa-pump-soap', title: 'Nettoyage', text: 'Savon doux au pH neutre, puis rinçage au sérum physiologique.' },
            { icon: 'fa-solid fa-hand-holding-droplet', title: 'Séchage', text: 'Tamponnez avec une compresse stérile, sans frotter.' },
            { icon: 'fa-solid fa-hand', title: 'On n’y touche pas', text: 'Ne tournez pas le bijou et gardez-le en place jusqu’à la fin de la cicatrisation.' },
        ],
        eviter: ['Dormir dessus', 'Alcool et produits irritants', 'Bain, piscine, baignade', 'Retirer le bijou soi-même'],
        normal: ['Rougeur, sensibilité ou léger gonflement les premiers jours', 'Sécrétion claire et petite croûte (lymphe)'],
        consulter: ['Douleur forte ou qui augmente', 'Gonflement marqué, rougeur qui s’étend', 'Écoulement inhabituel ou fièvre'],
        bonus: 'En cas de suspicion d’infection, ne retirez pas le bijou sans avis médical.',
    },
    {
        id: 'maquillage',
        label: 'Maquillage permanent',
        icon: 'fa-solid fa-wand-magic-sparkles',
        image: 'img/site/soins-maquillage.jpg',
        intro: 'Les bons réflexes pour préserver la tenue et la qualité de votre pigmentation.',
        routine: [
            { icon: 'fa-solid fa-hands-bubbles', title: 'Mains propres', text: 'Lavez-vous les mains avant tout contact avec la zone pigmentée.' },
            { icon: 'fa-solid fa-jar', title: 'Le soin', text: 'Une fine couche de Cicaplast Baume B5+ une fois par jour, sur peau propre et sèche.' },
            { icon: 'fa-solid fa-hourglass-half', title: 'Patience', text: 'Laissez les petites croûtes tomber d’elles-mêmes.' },
        ],
        eviter: ['Toucher, gratter, frotter', 'Gommage sur la zone', 'Piscine et bains', 'Maquillage et cosmétiques sur la zone'],
        normal: ['Rougeur, sensibilité, tiraillement', 'Petites croûtes', 'Couleur plus foncée au début, qui s’adoucit ensuite'],
        consulter: ['Une réaction qui vous inquiète ? Contactez Elsa', 'Demandez un avis médical si besoin'],
        bonus: 'Ne surchargez pas la zone de crème : une fine couche suffit.',
    },
] %}

{% block body %}
    <!-- Header Banner -->
    <section class="banner-header full-height valign bg-img bg-fixed" data-overlay-dark="4" data-background="{{ asset('img/site/soins-fond.jpg') }}">
        <div class="container">
            <div class="row">
                <div class="col-md-6 text-left caption mt-90">
                    <h5 class="animate-box" data-animate-effect="fadeInUp"><a href="{{ path('app_index') }}">Accueil</a> / Soins</h5>
                    <h1 class="animate-box" data-animate-effect="fadeInUp">Soins</h1>
                    <hr class="animate-box" data-animate-effect="fadeInUp">
                    <p class="animate-box" data-animate-effect="fadeInUp">Tout ce qu’il faut savoir pour bien cicatriser, en quelques gestes simples.</p>
                </div>
            </div>
        </div>
    </section>
    <!-- hr -->
    <div class="line-vr-section"></div>
    <!-- Soins -->
    <section class="soins section-padding">
        <div class="container">
            <div class="row mb-30">
                <div class="col-md-12 section-head text-center">
                    <div class="section-subtitle">Après votre séance</div>
                    <div class="section-title white">Vos <span>soins</span></div>
                    <p class="soins-hint">Choisissez votre prestation, puis cochez les étapes au fil de votre routine.</p>
                </div>
            </div>

            <ul class="nav soins-tabs" role="tablist">
                {% for soin in soins %}
                    <li class="nav-item" role="presentation">
                        <button class="soins-tab{{ loop.first ? ' active' }}" data-bs-toggle="pill" data-bs-target="#soin-{{ soin.id }}" type="button" role="tab" aria-controls="soin-{{ soin.id }}" aria-selected="{{ loop.first ? 'true' : 'false' }}">
                            <i class="{{ soin.icon }}"></i> {{ soin.label }}
                        </button>
                    </li>
                {% endfor %}
            </ul>

            <div class="tab-content">
                {% for soin in soins %}
                    <div class="tab-pane fade{{ loop.first ? ' show active' }}" id="soin-{{ soin.id }}" role="tabpanel">
                        <div class="row">
                            <div class="col-lg-4 mb-30">
                                <div class="soins-photo">
                                    <img src="{{ asset(soin.image) }}" alt="Soins {{ soin.label|lower }}">
                                    <div class="soins-photo-caption">{{ soin.intro }}</div>
                                </div>
                            </div>

                            <div class="col-lg-8">
                                <div class="soins-block-head">
                                    <h4>Ma routine</h4>
                                    <div class="soins-progress" data-progress>
                                        <span class="soins-progress-bar"></span>
                                        <span class="soins-progress-label">0 / {{ soin.routine|length }}</span>
                                    </div>
                                </div>
                                <div class="row">
                                    {% for etape in soin.routine %}
                                        <div class="col-md-6 mb-20">
                                            <button type="button" class="soins-step" data-step aria-pressed="false">
                                                <span class="soins-step-num">{{ loop.index }}</span>
                                                <span class="soins-step-icon"><i class="{{ etape.icon }}"></i></span>
                                                <span class="soins-step-body">
                                                    <strong>{{ etape.title }}</strong>
                                                    <span>{{ etape.text }}</span>
                                                </span>
                                                <span class="soins-step-check"><i class="fa-solid fa-check"></i></span>
                                            </button>
                                        </div>
                                    {% endfor %}
                                </div>

                                <h4 class="mt-30">À éviter</h4>
                                <div class="soins-chips">
                                    {% for item in soin.eviter %}
                                        <span class="soins-chip"><i class="fa-solid fa-ban"></i> {{ item }}</span>
                                    {% endfor %}
                                </div>

                                <div class="row mt-30">
                                    <div class="col-md-6 mb-20">
                                        <div class="soins-card soins-card--ok">
                                            <h5><i class="fa-solid fa-circle-check"></i> C’est normal</h5>
                                            <ul>
                                                {% for item in soin.normal %}<li>{{ item }}</li>{% endfor %}
                                            </ul>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-20">
                                        <div class="soins-card soins-card--alert">
                                            <h5><i class="fa-solid fa-triangle-exclamation"></i> À surveiller</h5>
                                            <ul>
                                                {% for item in soin.consulter %}<li>{{ item }}</li>{% endfor %}
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                                <p class="soins-bonus"><i class="fa-solid fa-lightbulb"></i> {{ soin.bonus }}</p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
    <!-- Contact CTA -->
    <section class="soins-cta section-padding bg-blck">
        <div class="container text-center">
            <div class="section-title white">Une <span>question</span> ?</div>
            <p>Un doute sur votre cicatrisation ? Écrivez-nous, on vous répond avec plaisir.</p>
            <a href="{{ path('app_contact') }}#contact" class="btn-curve btn-1 mt-10"><span>Nous contacter</span></a>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Cartes « routine » cochables, avec une barre de progression par onglet
        document.querySelectorAll('.soins .tab-pane').forEach(function (pane) {
            var steps = pane.querySelectorAll('[data-step]');
            var bar = pane.querySelector('.soins-progress-bar');
            var label = pane.querySelector('.soins-progress-label');

            function refresh() {
                var done = pane.querySelectorAll('[data-step].is-done').length;
                bar.style.width = (done / steps.length * 100) + '%';
                label.textContent = done === steps.length ? 'Bravo, tout est fait !' : done + ' / ' + steps.length;
            }

            steps.forEach(function (step) {
                step.addEventListener('click', function () {
                    var done = step.classList.toggle('is-done');
                    step.setAttribute('aria-pressed', done);
                    refresh();
                });
            });
        });
    </script>
{% endblock %}
