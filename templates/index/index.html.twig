{% block title %}Ginko art tattoo{% endblock %}

{% block body %}
    <!-- Parallax Image -->
    <section class="banner-header full-height valign bg-img bg-fixed" data-overlay-dark="2" data-background="img/slider/1.jpg">
        <div class="container">
            <div class="row content-justify-center">
                <div class="col-md-6 text-center">
                    <div class="v-middle">
                        <h4><span>Bienvenue chez Ginko Body Art</span></h4>
                        <h2>Soyez fier de votre<br><span>Nouveau Tattoo</span></h2>
                        <a href="#0" class="btn-curve btn-1 mt-30"><span>Voir nos réalisations</span></a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- hr -->
    <div class="line-vr-section"></div>
    <!-- About -->
    <section class="about section-padding">
    <div class="container">
        <div class="row">
            <div class="col-md-7 animate-box" data-animate-effect="fadeInLeft">
                <div class="section-subtitle">L'art, la beauté & le bien-être</div>
                <div class="section-title white">Ginko Body <span>Art</span></div>

                <p>
                    Bienvenue chez <strong>Ginko Body Art</strong>, un univers dédié à l’art, à la beauté et au bien-être.
                    Installé à Thoissey, notre shop réunit trois personnalités et trois savoir-faire complémentaires :
                    <strong>Miki</strong>, <strong>Jason</strong> et <strong>Elsa</strong>.
                </p>

                <p>
                    <strong>Miki</strong>, tatoueuse depuis plus de 20 ans, met son expérience et son univers artistique
                    au service de créations uniques et personnalisées. Elle accompagne chaque projet avec passion,
                    de la première idée jusqu’à sa réalisation sur la peau.
                </p>

                <p>
                    <strong>Jason</strong>, artiste et tatoueur, dessine depuis son plus jeune âge. Après une première
                    expérience dans le graphisme, il s’est naturellement tourné vers le tatouage, accompagné par Miki.
                    Spécialisé dans le <strong>fine line, le sketch et le micro-réalisme</strong>, il travaille principalement
                    en noir, blanc et nuances de gris.
                </p>

                <p>
                    <strong>Elsa</strong>, artiste et praticienne beauté, évolue depuis plus de 10 ans dans l’univers
                    de la beauté et du bien-être. Esthéticienne de formation, elle propose des prestations pensées
                    pour mettre en valeur chacun, avec écoute, précision et une attention particulière portée au
                    bien-être.
                </p>

                <ul class="about-list list-unstyled">
                    <li>
                        <div class="about-list-icon"><span class="ti-check"></span></div>
                        <div class="about-list-text">
                            <p>Un accompagnement personnalisé pour chaque projet</p>
                        </div>
                    </li>
                    <li>
                        <div class="about-list-icon"><span class="ti-check"></span></div>
                        <div class="about-list-text">
                            <p>Des artistes et praticiens aux savoir-faire complémentaires</p>
                        </div>
                    </li>
                    <li>
                        <div class="about-list-icon"><span class="ti-check"></span></div>
                        <div class="about-list-text">
                            <p>Un espace chaleureux dédié à l'art, la beauté et au bien-être</p>
                        </div>
                    </li>
                </ul>

                <p>
                    Que vous veniez pour un tatouage, un piercing, un soin beauté, un massage ou un maquillage permanent,
                    nous prenons le temps d'échanger avec vous afin de vous proposer une prestation qui vous ressemble,
                    dans une ambiance chaleureuse et bienveillante.
                </p>
            </div>

            <div class="col-md-5 mt-30 animate-box" data-animate-effect="fadeInRight">
                <img src="{{ asset('img/logo/LOGO BLANC.png') }}" alt="Logo">
            </div>
        </div>
    </div>
    </section>

        <!-- hr -->
        <div class="line-vr-section"></div>
        <!-- Process -->
        <section class="section-padding">
            <div class="container">
                <div class="row">
                    <div class="col-md-5 section-head animate-box" data-animate-effect="fadeInLeft">
                        <div class="section-subtitle">Notre processus</div>
                        <div class="section-title white">Comment ça <span>fonctionne</span></div>
                        <p>
                            Chaque projet de tatouage est unique. De la première prise de contact jusqu’aux retouches
                            finales, je vous accompagne pas à pas afin de créer un tatouage fidèle à votre histoire
                            et à vos envies.
                        </p>
                        <ul class="about-list list-unstyled">
                            <li>
                                <div class="about-list-icon"><span class="ti-layout-line-solid"></span></div>
                                <div class="about-list-text">
                                    <p>Échange personnalisé et accompagnement artistique</p>
                                </div>
                            </li>
                            <li>
                                <div class="about-list-icon"><span class="ti-layout-line-solid"></span></div>
                                <div class="about-list-text">
                                    <p>Respect strict des normes d’hygiène et de sécurité</p>
                                </div>
                            </li>
                        </ul>
                    </div>

                    <div class="col-md-6 offset-md-1 mt-30 animate-box" data-animate-effect="fadeInRight">
                        <div class="accrodion-grp" data-grp-name="process-faq-one-accrodion">

                            <div class="accrodion active">
                                <div class="accrodion-title">
                                    <h4><span>1.</span> Premier échange & devis</h4>
                                </div>
                                <div class="accrodion-content">
                                    <div class="inner">
                                        <p>
                                            Dès le premier contact (par SMS ou email), nous échangeons sur votre projet :
                                            style, taille, emplacement et thématique. Ce rendez-vous peut se faire au
                                            salon ou en visio. Suite à cet échange, un devis vous est proposé et une date
                                            est fixée, avec un délai moyen de 2 à 3 mois.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div class="accrodion">
                                <div class="accrodion-title">
                                    <h4><span>2.</span> Création du design</h4>
                                </div>
                                <div class="accrodion-content">
                                    <div class="inner">
                                        <p>
                                            Environ une semaine avant la séance, je vous envoie par email le design et
                                            la maquette de votre tatouage. Vous pourrez valider le visuel ou demander
                                            de légers ajustements afin qu’il corresponde parfaitement à vos attentes.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div class="accrodion">
                                <div class="accrodion-title">
                                    <h4><span>3.</span> Séance de tatouage</h4>
                                </div>
                                <div class="accrodion-content">
                                    <div class="inner">
                                        <p>
                                            Le jour J, nous validons ensemble le dessin, sa taille et son emplacement.
                                            Votre peau est préparée, le tatouage est réalisé, puis un film protecteur
                                            est appliqué. Toutes les consignes de soins vous sont expliquées.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div class="accrodion last-chiled">
                                <div class="accrodion-title">
                                    <h4><span>4.</span> Retouches & suivi</h4>
                                </div>
                                <div class="accrodion-content">
                                    <div class="inner">
                                        <p>
                                            Selon la taille ou la complexité du projet, plusieurs séances peuvent être
                                            nécessaires. Une séance de retouche peut être prévue 2 à 3 mois après la
                                            cicatrisation si besoin.
                                        </p>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </section>

