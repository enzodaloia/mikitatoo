{% extends 'base.html.twig' %}

{% block title %}Ginko Body Art - Bientôt en ligne{% endblock %}

{% block body %}
    <div class="comming section-padding">
		<div class="v-middle">
			<div class="container">
				<div class="row text-center mb-20">
					<div class="col-md-12">
						<img src="{{ asset('img/logo-ginko-body-art.png') }}" style="width: 260px; max-width: 70vw;" class="logo-img" alt="Ginko Body Art">
					</div>
					<div class="col-md-12">
						<h1 id="coming-title">On arrive bientôt !</h1>
						<p id="coming-text">Inauguration le 27 novembre à 18h. Notre nouveau site est en construction !</p>
					</div>
				</div>
				<div class="row text-center">
					<div class="col-6 offset-md-2 col-md-2">
						<div class="item">
							<div class="down">
								<h3 id="days">00</h3>
							</div>
							<div class="item-info">
								<h6>Jours</h6>
							</div>
						</div>
					</div>
					<div class="col-6 col-md-2">
						<div class="item">
							<div class="down">
								<h3 id="hours">00</h3>
							</div>
							<div class="item-info">
								<h6>Heures</h6>
							</div>
						</div>
					</div>
					<div class="col-6 col-md-2">
						<div class="item">
							<div class="down">
								<h3 id="minutes">00</h3>
							</div>
							<div class="item-info">
								<h6>Minutes</h6>
							</div>
						</div>
					</div>
					<div class="col-6 col-md-2">
						<div class="item">
							<div class="down">
								<h3 id="seconds">00</h3>
							</div>
							<div class="item-info">
								<h6>Secondes</h6>
							</div>
						</div>
					</div>
				</div>
				<div class="row text-center">
					<div class="offset-md-3 col-md-6">
						<p>Enregistrez-vous pour recevoir un mail le jour du lancement du site !</p>
						<form>
							<input type="email" name="email" placeholder="Email">
							<button>Inscription</button>
						</form>
					</div>
				</div>
				{# <div class="row text-center">
					<div class="go-back col-md-12">
						<a href='index.html'> <span><i class="ti-arrow-left" aria-hidden="true"></i></span>&nbsp; Back To Home </a>
					</div>
				</div> #}
			</div>
		</div>
	</div>

	<script>
		document.addEventListener("DOMContentLoaded", function () {

			// Inauguration : 27 novembre 2026 à 18h, heure de Paris (UTC+1 en novembre).
			// Le fuseau est explicite pour que le timer soit juste quel que soit le pays du visiteur.
			const eventDate = new Date("2026-11-27T18:00:00+01:00").getTime();
			const pad = (n) => String(n).padStart(2, "0");
			const set = (id, v) => { document.getElementById(id).textContent = v; };
			let timer;

			function countdown() {
				const remTime = eventDate - Date.now();

				if (remTime <= 0) {
					["days", "hours", "minutes", "seconds"].forEach((id) => set(id, "00"));
					set("coming-title", "C'est le jour J !");
					set("coming-text", "Le studio Ginko Body Art ouvre ses portes, le site arrive très vite.");
					clearInterval(timer);
					return;
				}

				set("days", pad(Math.floor(remTime / 86400000)));
				set("hours", pad(Math.floor(remTime / 3600000) % 24));
				set("minutes", pad(Math.floor(remTime / 60000) % 60));
				set("seconds", pad(Math.floor(remTime / 1000) % 60));
			}

			countdown();
			timer = setInterval(countdown, 1000);
		});
	</script>
{% endblock %}
