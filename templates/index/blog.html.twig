{% extends 'base.html.twig' %}

{% block title %}Ginko art tattoo{% endblock %}

{% block body %}
<style>
    .post-img img {
        width: 100%;
        height: 600px;
        object-fit: cover;
        display: block;
    }

    @media (max-width: 767px) {
        .post-img img {
            height: 220px;
        }
    }
</style>
<!-- Header Banner -->
<section class="banner-header section-padding valign bg-img bg-fixed" data-overlay-dark="2" data-background="img/slider/1.jpg">
    <div class="container">
        <div class="row">
            <div class="col-md-6 text-left caption mt-90">
                <h5 class="animate-box" data-animate-effect="fadeInUp"><a href="{{ path('app_index') }}">Accueil</a> / Blog</h5>
                <h1 class="animate-box" data-animate-effect="fadeInUp">Nouveauté & Actualité</h1>
                <hr class="animate-box" data-animate-effect="fadeInUp">
                <p class="animate-box" data-animate-effect="fadeInUp">Retrouvez toutes les nouveautés (tattoo, piercing...) et actualité dans cette page.</p>
            </div>
        </div>
    </div>
</section>
<!-- hr -->
<div class="line-vr-section"></div>
<!-- Blog -->

<section class="blog2 section-padding bg-blck">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        {% for b in blog %}
                            <div class="item">
                                <div class="post-img">
                                    <a href="{{ path('app_blog_show', {'id': b.id}) }}">
                                        <img src="{{ asset('uploads/blog/' ~ b.img) }}" alt="{{ b.title }}">
                                    </a>

                                    <div class="date">
                                        <a href="{{ path('app_blog_show', {'id': b.id}) }}">
                                            <span>{{ b.createdAt|date('M') }}</span>
                                            <i>{{ b.createdAt|date('d') }}</i>
                                        </a>
                                    </div>
                                </div>

                                <div class="post-cont">
                                    <a href="{{ path('app_blog_index') }}">
                                        <span class="tag">Blog</span>
                                    </a>

                                    <h5>
                                        <a href="{{ path('app_blog_show', {'id': b.id}) }}">
                                            {{ b.title }}
                                        </a>
                                    </h5>

                                    <p>{{ b.content }}</p>

                                    <a href="{{ path('app_blog_show', {'id': b.id}) }}" class="btn-curve btn-1">
                                        <span>Lire l'article</span>
                                    </a>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    <div class="col-md-12">
                        <!-- Pagination -->
                        <ul class="pagination-wrap align-center mb-30 mt-30">
                            <li><a href="blog.html#"><i class="ti-angle-left"></i></a></li>
                            <li><a href="blog.html#" class="active">1</a></li>
                            <li><a href="blog.html#">2</a></li>
                            <li><a href="blog.html#">3</a></li>
                            <li><a href="blog.html#"><i class="ti-angle-right"></i></a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}